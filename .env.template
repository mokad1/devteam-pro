# DevTeam Pro — Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# cp .env.template .env

# ── LLM Provider Selection ─────────────────────────
# Options: openai | deepseek | qwen
LLM_PROVIDER=deepseek

# ── OpenAI ─────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ── DeepSeek ───────────────────────────────────────
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── 通义千问 (Qwen) ───────────────────────────────
# https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Default Model ──────────────────────────────────
# Override the default model for the selected provider.
# Leave empty to use provider defaults (gpt-4o / deepseek-chat / qwen-turbo).
DEFAULT_MODEL=

# ── Retry & Rate Limit ─────────────────────────────
MAX_RETRIES=3
REQUEST_TIMEOUT=120
RATE_LIMIT_RPM=30

# ── Pipeline ───────────────────────────────────────
MAX_FIX_ROUNDS=3
SANDBOX_TIMEOUT=120

# ── Logging ────────────────────────────────────────
LOG_LEVEL=INFO

# ── Data Directory ─────────────────────────────────
DATA_DIR=./data
